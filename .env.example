# Copy to .env.local and set real contact details and your production domain.

# Public canonical domain (no trailing slash). Replace before production launch.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Where the contact form POSTs JSON ({ name, email, projectType, message }).
# Leave empty until a backend is ready: the form will then say it is not connected.
# Example (Formspree): https://formspree.io/f/your-form-id
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Shown in the Contact section and used for the email fallback.
NEXT_PUBLIC_CONTACT_EMAIL=

# International format, for the WhatsApp link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
